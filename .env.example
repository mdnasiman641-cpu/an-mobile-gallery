# ------------------------------------------------------------------
# AN MOBILE GALLERY — environment variables
# Copy to .env.local for development. Never commit real values.
# ------------------------------------------------------------------

# Public site URL (no trailing slash). Used for canonical URLs, sitemap,
# Open Graph and JSON-LD. Development: http://localhost:3000
# Production: https://your-domain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project (Settings → API). These two are safe to expose.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. NEVER prefix with NEXT_PUBLIC_. Used by Admin → Staff users
# (create accounts), the AI product assistant and the stock import.
# In production set it as a Cloudflare *Secret*, not in any .env file.
SUPABASE_SERVICE_ROLE_KEY=

# ---- AI product assistant ---------------------------------------------
# AI provider API keys are entered in Admin → Settings → AI (not here).
# They are encrypted with a key derived from SUPABASE_SERVICE_ROLE_KEY.
# Optional: a separate 32+ character encryption secret instead. Secret.
AI_KEYS_ENCRYPTION_SECRET=

# ---- Stock system import (Lovable), see docs/STOCK-INTEGRATION.md ----
# Shared secret for the signed webhook (32+ characters). Secret.
STOCK_WEBHOOK_SECRET=
# Optional: "Sync stock now" pulls the full list from this https URL.
STOCK_EXPORT_URL=
# Optional: Bearer token for STOCK_EXPORT_URL. Secret.
STOCK_EXPORT_TOKEN=
# Name stored with imported products (default: lovable).
STOCK_SOURCE_NAME=lovable

# Optional cost/hosting switches
# true = serve uploaded images as-is (already WebP-compressed) with no
# server-side image transformation. Recommended on free hosting tiers.
NEXT_IMAGE_UNOPTIMIZED=false
# cloudflare = resize images with Cloudflare Image Transformations instead of
# the Next.js optimiser (use when deployed behind / on Cloudflare).
NEXT_IMAGE_LOADER=
# standalone = build a self-contained Node server for non-Vercel hosts.
NEXT_OUTPUT=

# Optional: Google Search Console verification token (the content="..."
# value only). Can also be set from Admin → SEO; the admin value wins.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
