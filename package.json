{
  "name": "an-mobile-gallery",
  "version": "1.0.0",
  "private": true,
  "description": "AN MOBILE GALLERY — mobile phone & gadgets e-commerce store with admin panel (Next.js + Supabase, Cloudflare Workers via OpenNext)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "cf:check": "node scripts/check-env.mjs pre",
    "cf:build": "node scripts/check-env.mjs pre && opennextjs-cloudflare build && node scripts/check-env.mjs post",
    "preview": "npm run cf:build && opennextjs-cloudflare preview",
    "deploy": "npm run cf:build && opennextjs-cloudflare deploy -- --keep-vars",
    "upload": "npm run cf:build && opennextjs-cloudflare upload -- --keep-vars",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "1.20.8",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.57.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.544.0",
    "next": "16.3.8",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.36.0",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "wrangler": "^4.90.1"
  }
}
